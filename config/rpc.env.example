# Template only; the launcher does not load files from config/.
# Copy to .local/rpc.env only for a new setup; preserve existing private values.
# This is an Infura credential, not the Meta MODEL_API_KEY.
INFURA_API_KEY=
# Infura derives Ethereum mainnet (1) and Sepolia (11155111) endpoints.
# Explicit trusted endpoints override the derived URL for that chain.
# RPC_1_URL=https://your-trusted-ethereum-rpc
# RPC_11155111_URL=https://your-trusted-sepolia-rpc
# RPC_8453_URL=https://your-trusted-base-rpc
# Optional dedicated tracing must support debug_traceCall or trace_call.
# TRACE_RPC_1_URL=https://your-trusted-ethereum-trace-rpc
# TRACE_RPC_11155111_URL=https://your-trusted-sepolia-trace-rpc

# GoPlus on/off switch: 1 enables queries; 0 disables them.
# This template starts disabled; edit .local/rpc.env to enable your installation.
# Unsupported chains and failed/missing observations remain unknown.
ENABLE_EXTERNAL_LOOKUPS=0
# Optional credential only, not an enable switch. Leave unset for anonymous queries.
# GOPLUS_TOKEN=
ENABLE_FORK_SIMULATION=1
# Optional bounded Sourcify source-match observations; not a code audit.
ENABLE_SOURCE_VERIFICATION=0
# The local chain always uses 127.0.0.1:8545; no post-sign monitoring is enabled.
