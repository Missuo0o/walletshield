# Copy to .local/meta.env only for a new setup; do not overwrite existing keys.
# Backend-only credentials. Never commit .local/ or send keys in chat.
MODEL_API_KEY=
ENABLE_META_AI=1
# Whole-backend API-attempt budget per UTC day; failures and repairs count.
AI_DAILY_LIMIT=100
# The backend fixes muse-wonder-1.0 at https://api.meta.ai/v1/responses.
# META_MODEL is not read from environment files; legacy entries are ignored.
# An empty MODEL_API_KEY produces no AI request or numeric score.
