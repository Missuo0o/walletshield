# Combined reference only: this file and a root .env are NOT automatically loaded.
# Prefer config/meta.env.example -> .local/meta.env and
# config/rpc.env.example -> .local/rpc.env. Preserve existing private files.
# Examples contain no credentials; .local/ is intentionally excluded from Git.

# AI: put these values in .local/meta.env. Never send keys in chat.
MODEL_API_KEY=
ENABLE_META_AI=1
# Daily API-attempt budget (failures count); enough for one full wallet-case pass.
AI_DAILY_LIMIT=100
# Fixed backend model: muse-wonder-1.0 at https://api.meta.ai/v1/responses
# META_MODEL is not an environment selector; old local entries are ignored.
# OpenAI keys are ignored.

# RPC/tools: put these values in .local/rpc.env.
# A Meta Model API key and an Infura API key are DIFFERENT credentials.
INFURA_API_KEY=
# INFURA_API_KEY enables Ethereum mainnet (1) and Sepolia (11155111).
# Explicit trusted endpoints override the Infura-derived URL for that chain.
# RPC_1_URL=https://your-trusted-ethereum-rpc
# RPC_11155111_URL=https://your-trusted-sepolia-rpc
# RPC_8453_URL=https://your-trusted-base-rpc
# Optional dedicated trace provider, with debug_traceCall or trace_call support.
# Uses the primary RPC snapshot only after chain/height/hash verification.
# Keys stay server-side; this does not enable unsupported methods on Infura.
# TRACE_RPC_1_URL=https://your-trusted-ethereum-trace-rpc
# TRACE_RPC_11155111_URL=https://your-trusted-sepolia-trace-rpc
ENABLE_EXTERNAL_LOOKUPS=0
# Change to 1 in your private rpc.env to enable GoPlus. An enabled local
# installation can legitimately differ from this opt-in repository default.
GOPLUS_TOKEN=
ENABLE_FORK_SIMULATION=1
# No scheduled post-sign monitoring.
ENABLE_MONITOR=0
