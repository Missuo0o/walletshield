# Copy to .local/service.env and replace placeholders before hosted builds.
# No API keys belong in this file. Meta and RPC credentials remain backend-only.
WALLETSHIELD_SERVICE_MODE=hosted
WALLETSHIELD_APP_ORIGIN=https://walletshield.example.com
WALLETSHIELD_SNAP_PACKAGE=@your-owned-npm-scope/walletshield-snap
WALLETSHIELD_REPOSITORY_URL=https://github.com/your-org/your-repository
WALLETSHIELD_WALLET_DAILY_LIMIT=20
WALLETSHIELD_MAX_SCANS=3
