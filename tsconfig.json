{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "jsx": "react-jsx", "types": ["node"], "noEmit": true
  },
  "include": ["src", "web/src", "scripts/*.ts", "tests", "vite.config.ts"],
  "exclude": ["snap"]
}
